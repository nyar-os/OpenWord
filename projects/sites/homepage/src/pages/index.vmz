<template>
    <SiteShell page="home">
        <section class="hero">
            <div class="hero__copy">
                <span class="eyebrow">In development · no public release</span>
                <h1>
                    Word documents that stay structured —<br />from outline to export.
                </h1>
                <p class="hero__sub">
                    OpenWord keeps paragraphs, styles, tables and links in one
                    inspectable document model. The authoring engine is not
                    implemented yet, so every studio command reports
                    <code>capability/not-implemented</code> instead of inventing
                    a document.
                </p>
                <div class="hero__cta">
                    <Link to="FeaturesPage" class="btn btn--primary">
                        Explore features
                    </Link>
                    <Link to="RoadmapPage" class="btn btn--ghost">
                        Read the roadmap
                    </Link>
                </div>
                <p class="hero__note">
                    docx · docm · dotx · dotm · doc · rtf · odt · txt · md · html · pdf
                    — declared, not supported.
                </p>
            </div>

            <div class="frame" aria-hidden="true">
                <div class="frame__titlebar">
                    <span class="frame__mark">W</span>
                    <span class="frame__name">OpenWord Studio</span>
                    <span class="frame__doc">No document open</span>
                    <span class="frame__chip">capability/not-implemented</span>
                </div>
                <div class="frame__toolbar">
                    <span class="frame__group">
                        <span class="frame__label">File</span>
                        <span class="frame__btn">New</span>
