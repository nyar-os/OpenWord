                        <span class="frame__btn">Save</span>
                        <span class="frame__btn">Export</span>
                    </span>
                    <span class="frame__group">
                        <span class="frame__label">View</span>
                        <span class="frame__btn">Fit</span>
                        <span class="frame__btn">100%</span>
                        <span class="frame__btn">Zoom in</span>
                    </span>
                </div>
                <div class="frame__body">
                    <div class="frame__rail">
                        <span class="frame__rail-title">Document</span>
                        <span class="frame__rail-line">Title —</span>
                        <span class="frame__rail-line">Revision —</span>
                        <span class="frame__rail-title">Outline</span>
                        <span class="frame__rail-line">Nothing is open.</span>
                        <span class="frame__rail-title">Export targets</span>
                        <span class="frame__rail-line">docx · unsupported</span>
                        <span class="frame__rail-line">pdf · unsupported</span>
                    </div>
                    <div class="frame__canvas">
                        <div class="frame__ruler-h">
                            <span>0</span>
                            <span>2</span>
                            <span>4</span>
                            <span>6</span>
                            <span>8</span>
                        </div>
