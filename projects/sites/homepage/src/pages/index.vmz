<script client>
function formatRow(name) {
    return { name, importState: "unsupported", editState: "unsupported", exportState: "unsupported", status: "declared" };
}

export default class IndexPage {
    formats = [
        formatRow("docx"),
        formatRow("docm"),
        formatRow("dotx"),
        formatRow("dotm"),
        formatRow("doc"),
        formatRow("rtf"),
        formatRow("odt"),
        formatRow("txt"),
        formatRow("md"),
        formatRow("html"),
        formatRow("pdf"),
    ];

    static meta() {
        return {
            title: "OpenWord — structured Word documents for people and agents",
            description:
                "OpenWord declares one document model for authoring, template fill and review. The authoring engine, renderer and DOCX exchange are not implemented yet.",
        };
    }
}
</script>
